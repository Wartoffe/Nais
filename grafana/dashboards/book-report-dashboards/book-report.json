{
  "title": "Book Report",
  "uid": "book-report-dash",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "tags": ["books", "report"],
  "time": {
    "from": "1900-01-01T00:00:00.000Z",
    "to": "2030-12-31T00:00:00.000Z"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "genre",
        "type": "query",
        "label": "Genre",
        "description": "Pulled live from the genres field in Elasticsearch - pick any value to filter the first panel",
        "datasource": { "type": "elasticsearch", "uid": "es-books" },
        "query": "{\"find\": \"terms\", \"field\": \"genres\"}",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "value": "Horror",
          "text": "Horror"
        }
      },
      {
        "name": "cutoff_date",
        "type": "textbox",
        "label": "Published before",
        "description": "Books published before this date (yyyy-MM-dd) will appear in the 'Published Before' panel",
        "query": "2000-01-01",
        "current": {
          "value": "2000-01-01",
          "text": "2000-01-01"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "$genre Books",
      "description": "All books tagged with the selected genre (dropdown, top left). Not affected by the time picker above (the default time range is wide enough to include every book in the index).",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "elasticsearch", "uid": "es-books" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "es-books" },
          "query": "genres:$genre AND NOT hidden:true",
          "alias": "",
          "metrics": [
            { "id": "1", "type": "raw_data", "settings": { "size": "500" } }
          ],
          "bucketAggs": [],
          "timeField": "publishDate"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_id": true,
              "_index": true,
              "_type": true,
              "sort": true,
              "highlight": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Published Before $cutoff_date",
      "description": "All books with publishDate earlier than the cutoff variable above. Adjust the variable, not the time picker, to change this list.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "elasticsearch", "uid": "es-books" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "es-books" },
          "query": "publishDate:[* TO $cutoff_date] AND NOT hidden:true",
          "alias": "",
          "metrics": [
            { "id": "1", "type": "raw_data", "settings": { "size": "500" } }
          ],
          "bucketAggs": [],
          "timeField": "publishDate"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_id": true,
              "_index": true,
              "_type": true,
              "sort": true,
              "highlight": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Full-text \"sky\" within selected time range",
      "description": "Searches title, originalTitle, subtitle, description and textExcerpt for 'sky'. The dashboard time picker (top right) controls the publishDate range here \u2014 this is the one panel that's meant to be driven by it.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "elasticsearch", "uid": "es-books" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "es-books" },
          "query": "(title:sky OR originalTitle:sky OR subtitle:sky OR description:sky OR textExcerpt:sky) AND NOT hidden:true",
          "alias": "",
          "metrics": [
            { "id": "1", "type": "raw_data", "settings": { "size": "500" } }
          ],
          "bucketAggs": [],
          "timeField": "publishDate"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "_id": true,
              "_index": true,
              "_type": true,
              "sort": true,
              "highlight": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Books by Genre",
      "description": "Genre distribution across the whole catalog \u2014 the graphic for the report.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "elasticsearch", "uid": "es-books" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "elasticsearch", "uid": "es-books" },
          "query": "NOT hidden:true",
          "alias": "",
          "metrics": [
            { "id": "1", "type": "count" }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "genres",
              "settings": {
                "size": "30",
                "order": "desc",
                "orderBy": "_count",
                "min_doc_count": "1"
              }
            }
          ],
          "timeField": "publishDate"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": { "showLegend": false }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ]
}
